+static unordered_map<string, int32_t> sLibraryByReadGroup;
+
+void initializeLibraryIds() {
+    sLibraryByReadGroup.clear();
+    unordered_map<string, int32_t> idsByLibrary;
+    int32_t nextId = 1;
+    const int readGroupCount = sam_hdr_count_lines(nsgv::gInBamHeader, "RG");
+    for (int i = 0; i < readGroupCount; ++i) {
+        kstring_t readGroup = KS_INITIALIZE;
+        kstring_t library = KS_INITIALIZE;
+        if (sam_hdr_find_tag_pos(nsgv::gInBamHeader, "RG", i, "ID", &readGroup) == 0) {
+            string libraryName = "Unknown Library";
+            if (sam_hdr_find_tag_pos(nsgv::gInBamHeader, "RG", i, "LB", &library) == 0 && library.l > 0) {
+                libraryName.assign(library.s, library.l);
+            }
+            int32_t libraryId = 0;
+            if (libraryName != "Unknown Library") {
+                auto inserted = idsByLibrary.emplace(libraryName, nextId);
+                if (inserted.second) ++nextId;
+                libraryId = inserted.first->second;
+            }
+            sLibraryByReadGroup[string(readGroup.s, readGroup.l)] = libraryId;
+        }
+        free(readGroup.s);
+        free(library.s);
+    }
+}
+
+static int32_t getLibraryId(BamWrap &bw) {
+    const uint8_t *tag = bam_aux_get(bw.b, "RG");
+    const char *readGroup = tag == nullptr ? nullptr : bam_aux2Z(tag);
+    if (readGroup == nullptr) return 0;
+    auto found = sLibraryByReadGroup.find(readGroup);
+    return found == sLibraryByReadGroup.end() ? 0 : found->second;
+}
